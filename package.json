{
  "name": "@avinash-singh-io/engram",
  "version": "0.12.0",
  "description": "OKF-native knowledge base that agents and humans read and write together \u2014 durable memory, sibling to momentum.",
  "type": "module",
  "license": "MIT",
  "author": "Avinash Kumar Singh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/avinash-singh-io/engram.git"
  },
  "homepage": "https://github.com/avinash-singh-io/engram#readme",
  "bugs": "https://github.com/avinash-singh-io/engram/issues",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "okf",
    "knowledge-base",
    "agents",
    "markdown",
    "obsidian",
    "progressive-disclosure"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "engram": "dist/cli.js"
  },
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/obsidian",
    "assets"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.plugin.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests plugin",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run build && npm run smoke:cli && npm run smoke:plugin",
    "prepublishOnly": "npm run check",
    "smoke:plugin": "node scripts/smoke-plugin.mjs",
    "smoke:cli": "node scripts/smoke-cli.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.11.1",
    "@types/node": "^22.7.4",
    "eslint": "^9.11.1",
    "obsidian": "^1.13.1",
    "prettier": "^3.3.3",
    "tsup": "^8.3.0",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.8.0",
    "vitest": "^2.1.1"
  }
}
